# Local dev: leave TURSO_DATABASE_URL empty to use ./data/local.sqlite
# Production (Netlify): libsql://<db-name>-<org>.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# At least 32 characters — encrypts the admin session cookie
NUXT_SESSION_PASSWORD=change-me-to-a-long-random-string-of-32-chars-min

# Generate with: npm run hash-password -- "your-password"
NUXT_ADMIN_PASSWORD_HASH=
